MIMO_API_KEY=your_api_key_here
MIMO_API_URL=https://api.xiaomimimo.com/v1/chat/completions
MIMO_ASR_MODEL=mimo-v2.5-asr
MIMO_SUMMARY_MODEL=mimo-v2.6-flash
PORT=3000

# 阿里云百炼实时语音识别（WebSocket）
# apiKey-*.csv 里的 apiKey / apiHost / workspaceId 对应下面三项
DASHSCOPE_API_KEY=sk-xxxxxxxx
BAILIAN_WS_HOST={WorkspaceId}.cn-beijing.maas.aliyuncs.com
BAILIAN_WORKSPACE={WorkspaceId}
ASR_MODEL=qwen-audio-3.0-asr-flash-streaming

# 静态文件说话人分离模型（可选，不填用下面的默认值）
DIAR_MODEL=qwen-audio-3.0-asr-flash-filetrans
